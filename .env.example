# Copy to `.env` for local runs. Never commit `.env`.
# All application settings use the CITED_RAG_ prefix.

CITED_RAG_ENVIRONMENT=development
CITED_RAG_API_KEY=replace-me
CITED_RAG_LOG_LEVEL=INFO
CITED_RAG_DEBUG=false
CITED_RAG_DATABASE_URL=postgresql+asyncpg://cited_rag:cited_rag@localhost:5432/cited_rag
CITED_RAG_LOCAL_STORAGE_PATH=./data/objects
CITED_RAG_MAX_UPLOAD_BYTES=20971520
CITED_RAG_REDIS_URL=redis://localhost:6379/0
CITED_RAG_PARSER_BACKEND=pypdf
CITED_RAG_CHUNK_TARGET_CHARS=1200
CITED_RAG_CHUNK_OVERLAP_CHARS=200

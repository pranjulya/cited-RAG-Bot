# Copy to `.env` for local runs. Never commit `.env`.
# All application settings use the CITED_RAG_ prefix.

CITED_RAG_ENVIRONMENT=development
CITED_RAG_API_KEY=replace-me
CITED_RAG_LOG_LEVEL=INFO
CITED_RAG_DEBUG=false
# Compose publishes Postgres on host 5433 (container 5432) so a local
# Postgres on 5432 is not selected by mistake.
CITED_RAG_DATABASE_URL=postgresql+asyncpg://cited_rag:cited_rag@localhost:5433/cited_rag
CITED_RAG_LOCAL_STORAGE_PATH=./data/objects
CITED_RAG_MAX_UPLOAD_BYTES=20971520
CITED_RAG_REDIS_URL=redis://localhost:6379/0
CITED_RAG_PARSER_BACKEND=pypdf
CITED_RAG_CHUNK_TARGET_CHARS=1200
CITED_RAG_CHUNK_OVERLAP_CHARS=200
CITED_RAG_QDRANT_URL=http://localhost:6333
CITED_RAG_QDRANT_COLLECTION=cited_rag
CITED_RAG_EMBEDDING_BACKEND=hash
CITED_RAG_EMBEDDING_MODEL=hash-v1
CITED_RAG_EMBEDDING_DIMENSION=32
CITED_RAG_EMBEDDING_BATCH_SIZE=32
CITED_RAG_INDEX_VERSION=v1
CITED_RAG_SPARSE_ENCODER_BACKEND=lexical
CITED_RAG_SPARSE_ENCODER_NAME=lexical_tf_v1
CITED_RAG_SPARSE_ENCODER_VERSION=v1
CITED_RAG_RETRIEVAL_TOP_K=20
CITED_RAG_RRF_K=60
CITED_RAG_FUSED_TOP_K=20
CITED_RAG_RERANKER_BACKEND=overlap
CITED_RAG_RERANK_TOP_N=10
CITED_RAG_RERANKER_TIMEOUT_SECONDS=5
CITED_RAG_MAX_EVIDENCE_ITEMS=8
CITED_RAG_CONTEXT_TOKEN_BUDGET=1500
CITED_RAG_GENERATION_BACKEND=heuristic
CITED_RAG_GENERATION_BASE_URL=https://api.openai.com/v1
CITED_RAG_GENERATION_MODEL=gpt-4o-mini
# Only set these three values for a hosted-generation demo. Never put the key in VITE_*.
# CITED_RAG_GENERATION_API_KEY=
CITED_RAG_GENERATION_TIMEOUT_SECONDS=15
# Optional shadow-only Jev decision observation. Never put a real key in this file.
# CITED_RAG_JEV_SHADOW_ENABLED=false
# CITED_RAG_JEV_BASE_URL=https://api.typesafe.ai
# CITED_RAG_JEV_MODEL=typesafe/jev-1.13
# CITED_RAG_JEV_API_KEY=
# CITED_RAG_JEV_TIMEOUT_SECONDS=2
CITED_RAG_MIN_RERANK_SCORE=0
CITED_RAG_QUERY_MAX_CHARS=4000
CITED_RAG_MAX_IN_FLIGHT_QUERIES=32
CITED_RAG_LOG_SENSITIVE_CONTENT=false
CITED_RAG_CORS_ALLOW_ORIGINS=*
